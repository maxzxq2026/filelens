{
  "version": "1.0",
  "description": "FileLens 默认安全分级规则 — 系统目录 > App目录 > 缓存目录 > 用户目录",
  "_logic": {
    "conditions": "每个 conditions 数组内的元素是 OR 关系（任一匹配即命中规则）",
    "priority": "多条规则匹配时，priority 值越大越优先；同 priority 按数组顺序",
    "pathMatchType": "prefix=前缀, contains=包含, suffix=后缀, exact=精确匹配",
    "nameMatchType": "contains=包含, exact=精确, prefix=前缀, suffix=后缀, ext=扩展名"
  },
  "rules": [
    {
      "id": "critical-system-dirs",
      "level": "critical",
      "priority": 100,
      "description": "系统核心目录下的所有文件",
      "conditions": [
        { "pathMatch": "/System/", "pathMatchType": "prefix" },
        { "pathMatch": "/usr/lib/", "pathMatchType": "prefix" },
        { "pathMatch": "/usr/bin/", "pathMatchType": "prefix" }
      ]
    },
    {
      "id": "critical-system-files",
      "level": "critical",
      "priority": 100,
      "description": "系统核心文件名",
      "conditions": [
        { "nameMatch": "libSystem", "nameMatchType": "contains" },
        { "nameMatch": "libc++", "nameMatchType": "contains" },
        { "nameMatch": "libobjc", "nameMatchType": "contains" },
        { "nameMatch": "kernel", "nameMatchType": "contains" }
      ]
    },
    {
      "id": "critical-extensions",
      "level": "critical",
      "priority": 95,
      "description": "内核扩展和驱动",
      "conditions": [
        { "extensions": ["kext", "driver"] }
      ]
    },
    {
      "id": "caution-app-bundles",
      "level": "caution",
      "priority": 80,
      "description": "Applications 下的 .app 包内容",
      "conditions": [
        { "pathMatch": "/Applications/", "pathMatchType": "prefix" }
      ]
    },
    {
      "id": "caution-app-contents",
      "level": "caution",
      "priority": 75,
      "description": "App 包内的结构目录",
      "conditions": [
        { "pathMatch": ".app/Contents/", "pathMatchType": "contains", "nameMatch": "MacOS", "nameMatchType": "exact" },
        { "pathMatch": ".app/Contents/", "pathMatchType": "contains", "nameMatch": "Resources", "nameMatchType": "exact" },
        { "pathMatch": ".app/Contents/", "pathMatchType": "contains", "nameMatch": "Frameworks", "nameMatchType": "exact" }
      ]
    },
    {
      "id": "caution-library-support",
      "level": "caution",
      "priority": 72,
      "description": "用户 Library 下的 App 支持文件",
      "conditions": [
        { "pathMatch": "/Library/Application Support/", "pathMatchType": "prefix" },
        { "pathMatch": "/Library/Preferences/", "pathMatchType": "prefix" },
        { "pathMatch": "/Library/Containers/", "pathMatchType": "prefix" }
      ]
    },
    {
      "id": "caution-dylib",
      "level": "caution",
      "priority": 70,
      "description": "非系统目录下的动态库",
      "conditions": [
        { "extensions": ["dylib"] }
      ]
    },
    {
      "id": "cleanable-cache-dirs",
      "level": "cleanable",
      "priority": 60,
      "description": "缓存和日志目录",
      "conditions": [
        { "pathMatch": "/Library/Caches/", "pathMatchType": "prefix" },
        { "pathMatch": "/Library/Logs/", "pathMatchType": "prefix" },
        { "pathMatch": "/tmp/", "pathMatchType": "prefix" }
      ]
    },
    {
      "id": "cleanable-dev-caches",
      "level": "cleanable",
      "priority": 55,
      "description": "开发工具缓存目录",
      "conditions": [
        { "pathMatch": "/.gradle/", "pathMatchType": "contains" },
        { "pathMatch": "/.npm/", "pathMatchType": "contains" },
        { "pathMatch": "/.cargo/", "pathMatchType": "contains" },
        { "pathMatch": "/node_modules/", "pathMatchType": "contains" },
        { "pathMatch": "/__pycache__/", "pathMatchType": "contains" },
        { "pathMatch": "/.cache/", "pathMatchType": "contains" },
        { "pathMatch": "/DerivedData/", "pathMatchType": "contains" }
      ]
    },
    {
      "id": "cleanable-cache-extensions",
      "level": "cleanable",
      "priority": 50,
      "description": "缓存/临时文件扩展名",
      "conditions": [
        { "extensions": ["log", "cache", "tmp", "temp", "bak"] }
      ]
    },
    {
      "id": "cleanable-cache-names",
      "level": "cleanable",
      "priority": 45,
      "description": "文件名包含缓存/临时关键词（限定完整单词，避免误匹配 catalogue/template 等）",
      "conditions": [
        { "nameMatch": "_cache", "nameMatchType": "contains" },
        { "nameMatch": ".cache", "nameMatchType": "contains" },
        { "nameMatch": "_temp", "nameMatchType": "contains" },
        { "nameMatch": ".temp", "nameMatchType": "contains" },
        { "nameMatch": "_log", "nameMatchType": "suffix" },
        { "nameMatch": ".log", "nameMatchType": "suffix" }
      ]
    },
    {
      "id": "safe-downloads",
      "level": "safe",
      "priority": 20,
      "description": "下载目录文件",
      "conditions": [
        { "pathMatch": "/Downloads/", "pathMatchType": "prefix" }
      ]
    },
    {
      "id": "safe-desktop",
      "level": "safe",
      "priority": 20,
      "description": "桌面文件",
      "conditions": [
        { "pathMatch": "/Desktop/", "pathMatchType": "prefix" }
      ]
    },
    {
      "id": "safe-documents",
      "level": "safe",
      "priority": 15,
      "description": "文档目录文件",
      "conditions": [
        { "pathMatch": "/Documents/", "pathMatchType": "prefix" }
      ]
    }
  ]
}
